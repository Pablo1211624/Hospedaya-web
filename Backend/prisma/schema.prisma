generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alojamiento {
  id_alojamiento     BigInt               @id @default(autoincrement())
  nombre             String               @db.VarChar(150)
  descripcion        String?
  direccion          String               @db.VarChar(255)
  ciudad             String               @default("") @db.VarChar(100)
  habitaciones       Int                  @default(1)
  banos              Int                  @default(1)
  amenidades         String               @default("")
  reglas             String               @default("")
  capacidad          Int
  precio_noche       Decimal              @db.Decimal(10, 2)
  estado             String               @default("ACTIVO") @db.VarChar(20)
  id_usuario         BigInt
  usuario            usuario              @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: NoAction, map: "fk_alojamiento_usuario")
  disponibilidad     disponibilidad[]
  imagen_alojamiento imagen_alojamiento[]
  reserva            reserva[]
  @@index([id_usuario])
  @@index([ciudad, estado])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model costo_reserva {
  id_costo_reserva      BigInt  @id @default(autoincrement())
  precio_noche_aplicado Decimal @db.Decimal(10, 2)
  cantidad_noches       Int
  total                 Decimal @db.Decimal(12, 2)
  id_reserva            BigInt  @unique
  reserva               reserva @relation(fields: [id_reserva], references: [id_reserva], onDelete: Cascade, onUpdate: NoAction, map: "fk_costo_reserva")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model disponibilidad {
  id_disponibilidad BigInt      @id @default(autoincrement())
  fecha_inicio      DateTime    @db.Date
  fecha_fin         DateTime    @db.Date
  estado            String      @default("DISPONIBLE") @db.VarChar(20)
  id_alojamiento    BigInt
  alojamiento       alojamiento @relation(fields: [id_alojamiento], references: [id_alojamiento], onDelete: Cascade, onUpdate: NoAction, map: "fk_disponibilidad_alojamiento")
  @@index([id_alojamiento, fecha_inicio, fecha_fin])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model imagen_alojamiento {
  id_imagen      BigInt      @id @default(autoincrement())
  url_imagen     String
  es_principal   Boolean     @default(false)
  orden          Int         @default(1)
  id_alojamiento BigInt
  alojamiento    alojamiento @relation(fields: [id_alojamiento], references: [id_alojamiento], onDelete: Cascade, onUpdate: NoAction, map: "fk_imagen_airbnb")
  @@index([id_alojamiento])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reserva {
  id_reserva         BigInt         @id @default(autoincrement())
  fecha_entrada      DateTime       @db.Date
  fecha_salida       DateTime       @db.Date
  cantidad_huespedes Int
  adultos            Int              @default(1)
  ninos              Int              @default(0)
  estado             String         @default("PENDIENTE") @db.VarChar(20)
  fecha_creacion     DateTime       @default(now()) @db.Timestamp(6)
  id_usuario         BigInt
  id_alojamiento     BigInt
  costo_reserva      costo_reserva?
  alojamiento        alojamiento    @relation(fields: [id_alojamiento], references: [id_alojamiento], onUpdate: NoAction, map: "fk_reserva_alojamiento")
  usuario            usuario        @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction, map: "fk_reserva_usuario")
  @@index([id_usuario])
  @@index([id_alojamiento, fecha_entrada, fecha_salida])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuario {
  id_usuario    BigInt        @id @default(autoincrement())
  nombre        String        @db.VarChar(100)
  biografia     String        @default("")
  correo        String        @unique @db.VarChar(255)
  password_hash String        @db.VarChar(255)
  rol           String        @db.VarChar(20)
  estado        String        @default("ACTIVO") @db.VarChar(20)
  alojamiento   alojamiento[]
  reserva       reserva[]
}
